.equ IND_SIZE, 88

# ---------------------------------------------------------------- printer (src/astdoc.s)
# Print args (the `args` of print(selector, args)); 0 stands for undefined.
.equ ARGS_EXPAND_FIRST_ARG, 0   # u8 expandFirstArg
.equ ARGS_EXPAND_LAST_ARG, 1    # u8 expandLastArg
.equ ARGS_ASSIGNMENT_LAYOUT, 2  # u8 AL_*, 0 for undefined
.equ ARGS_SIZE, 8
.equ AL_BREAK_AFTER_OPERATOR, 1
.equ AL_NEVER_BREAK_AFTER_OPERATOR, 2
.equ AL_FLUID, 3
.equ AL_BREAK_LHS, 4
.equ AL_CHAIN, 5
.equ AL_CHAIN_TAIL, 6
.equ AL_CHAIN_TAIL_ARROW_CHAIN, 7
.equ AL_ONLY_LEFT, 8
.equ AL_COUNT, 9

# Printer record: the printer methods Prettier's generic code calls. Each is a
# function pointer, 0 when the printer does not have the method.
.equ PR_PRINT, 0                # print(node, args) -> doc; the node is the path's top
.equ PR_HAS_PRETTIER_IGNORE, 8  # hasPrettierIgnore() -> eax (path based)
.equ PR_WILL_PRINT_OWN_COMMENTS, 16 # willPrintOwnComments() -> eax (path based)
.equ PR_PRINT_COMMENT, 24       # printComment(comment) -> doc; the comment is the path's top
.equ PR_IS_BLOCK_COMMENT, 32    # isBlockComment(comment) -> eax
.equ PR_CAN_ATTACH_COMMENT, 40  # canAttachComment(node) -> eax; 0: comments are not attached
.equ PR_GET_COMMENT_CHILD_NODES, 48 # getCommentChildNodes(node) -> VEC, or 0 for undefined
.equ PR_VISITOR_KEYS, 56        # table by node type of byte lists (VK_*), 0-terminated, as ast_visitor_keys
.equ PR_VISITOR_COUNT, 64       # entries in that table
.equ PR_OWN_LINE, 72            # handleComments.ownLine: 0-terminated list of handlers
.equ PR_END_OF_LINE, 80         # handleComments.endOfLine
.equ PR_REMAINING, 88           # handleComments.remaining
.equ PR_IS_GAP, 96              # isGap(start, end) -> eax: 0, 1, or -1 for undefined
.equ PR_SIZE, 104
# printDanglingComments options
.equ DC_INDENT, 1
# Visitor key list entry: a byte, the field offset, | VK_VEC when the field is a VEC.
.equ VK_VEC, 0x80
# A comment handler: handler(comment, is_last_comment) -> eax 1 when it
# attached the comment. The comment's CM_ENCL, CM_PREC and CM_FOLL hold the
# context Prettier passes.

# JS `false` returned by the skip* text helpers.
.equ IDX_FALSE, -0x4000000000000000

# ---------------------------------------------------------------- macros
# Functions keep a frame pointer so gdb can walk the stack.
.macro FUNC name
    .text
    .globl \name
    .type \name, @function
\name:
    .cfi_startproc
    push rbp
    .cfi_def_cfa_offset 16
    .cfi_offset rbp, -16
    mov rbp, rsp
    .cfi_def_cfa_register rbp
.endm

.macro ENDF name
    .cfi_endproc
    .size \name, .-\name
.endm

# Refuse to format: never returns.
.macro REFUSE text
    .pushsection .rodata.refuse, "a"
.Lrefuse\@: .asciz "\text"
    .popsection
    lea rdi, [rip + .Lrefuse\@]
    call refuse
.endm

# Static string doc: label points at a DK_STR record.
.macro SDOC label, text
    .pushsection .data.sdoc, "aw"
    .balign 8
\label:
    .byte DK_STR, 0, 0, 0
    .long .Lsdoc_end\@ - .Lsdoc_txt\@
    .quad .Lsdoc_txt\@
    .quad .Lsdoc_end\@ - .Lsdoc_txt\@
    .pushsection .rodata.sdoc, "a"
.Lsdoc_txt\@: .ascii "\text"
.Lsdoc_end\@:
    .popsection
    .popsection
.endm
