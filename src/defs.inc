# Indentation record. PREV is the indentation of the queue without its last
# part (what a dedent returns); TC and TS count the trailing numeric aligns
# (generateInd's lastTabs and lastSpaces).
.equ IND_VALUE, 0
.equ IND_VLEN, 8
.equ IND_LENGTH, 16
.equ IND_ROOT, 24
.equ IND_PREV, 32
.equ IND_TC, 40
.equ IND_TS, 48
.equ IND_MEMO_IND, 56   # makeIndent(this), once computed
.equ IND_MEMO_KIND, 64  # last makeAlign(this, n): kind, n, result
.equ IND_MEMO_N, 72
